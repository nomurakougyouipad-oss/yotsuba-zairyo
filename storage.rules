rules_version = '2';

// よつば材料注文の写真の置き場（Firebase Storage・東京 asia-northeast1）
// - 現場・事務所が上げる写真：zairyo/photos/{端末の番号}/{番号}.jpg
//   上げられるのは、その端末の本人だけ（JPEG・3MB まで）。見られる・消せるのは、本人と事務所
// - Storage のルールはデータベースを読めないので、役割はログインのしるし（zr_role）で見る。
//   事務所が端末の登録を消しても、しるしは最大1時間のこる（Storage だけ、最大1時間のずれがある）
// - 材料屋（2回目）に見せるときは、そのときに決める
// - 納品書のスキャン（7-5c）：zairyo/scans/{端末の番号}/{番号}.jpg。事務所だけ
// - 注文につけるファイル（注文書・図面。10/15）：zairyo/files/{注文の番号}/{番号}.{拡張子}。事務所だけ
// - それ以外の場所は、だれも読めない・書けない
service firebase.storage {
  match /b/{bucket}/o {
    function member() {
      return request.auth != null && (request.auth.token.zr_role == 'genba' || request.auth.token.zr_role == 'office');
    }
    function office() {
      return request.auth != null && request.auth.token.zr_role == 'office';
    }

    match /zairyo/photos/{uid}/{file} {
      allow read: if member() && (request.auth.uid == uid || office());
      allow create: if member() && request.auth.uid == uid
        && file.matches('[A-Za-z0-9]+[.]jpg')
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if member() && (request.auth.uid == uid || office());
    }

    // 納品書のスキャン（7-5c）：事務所だけが上げる・見る・消す（JPEG・5MB まで）
    match /zairyo/scans/{uid}/{file} {
      allow read: if office();
      allow create: if office() && request.auth.uid == uid
        && file.matches('[A-Za-z0-9]+[.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if office();
    }

    // 注文につけるファイル（注文書・図面。10/15）：zairyo/files/{注文の番号}/{番号}.{拡張子}。事務所だけが上げる・見る・消す。
    // 1つ 200MB まで。種類はえらばない（Excel・DXF・DWG・JWW・PDF など）。上げたものは書きかえない（つけなおすときは、消してから）
    match /zairyo/files/{owner}/{file} {
      allow read: if office();
      allow create: if office()
        && owner.matches('[A-Za-z0-9_-]{1,40}')
        && file.matches('[A-Za-z0-9_-]{1,40}([.][a-z0-9]{1,10})?')
        && request.resource.size <= 200 * 1024 * 1024;
      allow delete: if office();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
