{
  "rules": {
    ".read": false,
    ".write": false,
    "common": {
      ".read": "auth != null && (auth.token.zr_role == 'genba' || auth.token.zr_role == 'office') && root.child('zairyo/devices/' + auth.uid + '/role').val() == auth.token.zr_role",
      ".write": "auth != null && auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office'",
      "kaisha": {
        "$code": {
          ".validate": "$code.matches(/^[A-Z]{2}$/) && newData.hasChildren(['name'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "kana": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "hidden": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "kotei": {
        "$key": {
          ".validate": "$key.matches(/^[A-Z]{2}[0-9]{3}$/) && newData.hasChildren(['name'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "hidden": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "chubanYear": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}$/)" },
      "$other": { ".validate": false }
    },
    "zairyo": {
      "devices": {
        ".read": "auth != null && auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office'",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid"
        }
      },
      "master": {
        ".read": "auth != null && (auth.token.zr_role == 'genba' || auth.token.zr_role == 'office') && root.child('zairyo/devices/' + auth.uid + '/role').val() == auth.token.zr_role",
        ".write": "auth != null && auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office'",
        "staff": {
          "$name": {
            ".validate": "$name.length >= 1 && $name.length <= 20 && newData.hasChildren(['addedAt'])",
            "addedAt": { ".validate": "newData.isNumber()" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "suppliers": {
          "$id": {
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "to": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "app": { ".validate": "newData.isBoolean()" },
            "azukari": { ".validate": "newData.isBoolean()" },
            "alias": {
              "$i": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" }
            },
            "order": { ".validate": "newData.isNumber()" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "places": {
          "$id": {
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "order": { ".validate": "newData.isNumber()" },
            "hidden": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "catalog": {
          ".validate": "newData.hasChildren(['cats', 'units'])"
        },
        "$other": { ".validate": false }
      },
      "requests": {
        ".read": "auth != null && ((auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office') || (auth.token.zr_role == 'genba' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'genba' && query.orderByChild == 'chumonsha' && query.equalTo == auth.token.zr_name))",
        ".indexOn": ["chumonsha", "sentAt"],
        "$id": {
          ".read": "auth != null && ((auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office') || (auth.token.zr_role == 'genba' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'genba' && data.child('chumonsha').val() == auth.token.zr_name))",
          ".write": "auth != null && ((auth.token.zr_role == 'office' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'office') || (auth.token.zr_role == 'genba' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'genba' && !data.exists() && newData.child('chumonsha').val() == auth.token.zr_name && newData.child('uid').val() == auth.uid && newData.child('status').val() == 'sent'))",
          ".validate": "newData.hasChildren(['chumonsha', 'uid', 'chuban', 'kenmei', 'sentAt', 'status', 'lines'])",
          "chumonsha": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "chuban": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}[0-9]{5}$/)" },
          "kenmei": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
          "tantou": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "typed": { ".validate": "newData.isBoolean()" },
          "kibou": { ".validate": "newData.isString() && (newData.val() == '最短' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))" },
          "basho": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "bashoId": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "contacted": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "contactedName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "memo": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "sentAt": { ".validate": "newData.isNumber() && (data.exists() || newData.val() == now)" },
          "status": {
            ".write": "auth != null && auth.token.zr_role == 'genba' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'genba' && data.parent().child('chumonsha').val() == auth.token.zr_name && data.val() == 'sent' && newData.val() == 'cancelled' && data.parent().child('ordered').val() != true",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "cancelledAt": {
            ".write": "auth != null && auth.token.zr_role == 'genba' && root.child('zairyo/devices/' + auth.uid + '/role').val() == 'genba' && data.parent().child('chumonsha').val() == auth.token.zr_name && !data.exists() && newData.parent().child('status').val() == 'cancelled' && data.parent().child('ordered').val() != true",
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "ordered": { ".validate": "newData.isBoolean()" },
          "lines": {
            "$line": {
              ".validate": "$line.length <= 40 && newData.hasChildren(['spec', 'qty', 'unit'])",
              "key": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "cat": { ".validate": "newData.isString() && newData.val().length <= 20" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "vals": { "$k": { ".validate": "$k.length <= 20 && newData.isString() && newData.val().length <= 200" } },
              "spec": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "qty": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000" },
              "unit": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
